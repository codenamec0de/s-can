    <color name="scan_hairline">@color/v4_hairline</color>
    <color name="scan_overlay_soft">@color/v4_surf_tint</color>
    <color name="scan_overlay_softer">@color/v4_surf_tint</color>
    <color name="scan_glass_bg">@color/v4_glass_bg</color>
</resources>
