<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/V4SettingsRow">

        <ImageView
            style="@style/V4SettingsRowIcon"
            android:src="@drawable/ic_v4_glyph_document" />

        <TextView
            android:id="@+id/sectionLabel"
            style="@style/V4SettingsRowSimpleLabel" />

        <ImageView style="@style/V4SettingsRowChevron" />
    </LinearLayout>

    <View
        android:id="@+id/sectionDivider"
        style="@style/V4SettingsDivider" />
</LinearLayout>
