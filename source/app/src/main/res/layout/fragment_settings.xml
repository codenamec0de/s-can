<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="-0.025"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:text="@string/settings_v4_title"
            android:textColor="@color/v4_fg0"
            android:textFontWeight="600"
            android:textSize="26sp" />

        <!-- Profile card -->
        <LinearLayout
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_v4_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_v4_settings_profile_tile"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile picture"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvProfileInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/montserrat"
                    android:textColor="@color/v4_accent"
                    android:textFontWeight="600"
                    android:textSize="17sp"
                    tools:text="J" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/montserrat"
                    android:maxLines="1"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="13.5sp"
                    tools:text="john@uow.edu.au" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/montserrat"
                    android:text="@string/settings_v4_profile_meta"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="500"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_glyph_chevron"
                app:tint="@color/v4_fg3" />
        </LinearLayout>

        <!-- ─── Account ─── -->
        <TextView
            style="@style/V4SettingsSectionLabel"
            android:text="@string/settings_v4_section_account" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_v4_surface"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/btnProfile"
                style="@style/V4SettingsRow">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_lock" />

                <LinearLayout style="@style/V4SettingsRowText">

                    <TextView
                        style="@style/V4SettingsRowTitle"
                        android:text="@string/settings_v4_account_profile_title" />

                    <TextView
                        style="@style/V4SettingsRowDesc"
                        android:text="@string/settings_v4_account_profile_desc" />
                </LinearLayout>

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/V4SettingsDivider" />

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/btnNotifications"
                style="@style/V4SettingsRow">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_bell" />

                <LinearLayout style="@style/V4SettingsRowText">

                    <TextView
                        style="@style/V4SettingsRowTitle"
                        android:text="@string/settings_v4_account_notifications_title" />

                    <TextView
                        style="@style/V4SettingsRowDesc"
                        android:text="@string/settings_v4_account_notifications_desc" />
                </LinearLayout>

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/V4SettingsDivider" />

            <!-- Scan Schedule -->
            <LinearLayout
                android:id="@+id/btnScanSchedule"
                style="@style/V4SettingsRow">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_activity" />

                <LinearLayout style="@style/V4SettingsRowText">

                    <TextView
                        style="@style/V4SettingsRowTitle"
                        android:text="@string/settings_v4_account_schedule_title" />

                    <TextView
                        style="@style/V4SettingsRowDesc"
                        android:text="@string/settings_v4_account_schedule_desc" />
                </LinearLayout>

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/V4SettingsDivider" />

            <!-- Data & Storage -->
            <LinearLayout
                android:id="@+id/btnDataStorage"
                style="@style/V4SettingsRow">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_v4_glyph_storage" />

                <LinearLayout style="@style/V4SettingsRowText">

                    <TextView
                        style="@style/V4SettingsRowTitle"
                        android:text="@string/settings_v4_account_data_title" />

                    <TextView
                        android:id="@+id/tvDataStorageDesc"
                        style="@style/V4SettingsRowDesc"
                        android:text="@string/settings_v4_account_data_desc_unknown" />
                </LinearLayout>

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── General ─── -->
        <TextView
            style="@style/V4SettingsSectionLabel"
            android:text="@string/settings_v4_section_general" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_v4_surface"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- About -->
            <LinearLayout
                android:id="@+id/btnAbout"
                style="@style/V4SettingsRowSimple">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_shield" />

                <TextView
                    style="@style/V4SettingsRowSimpleLabel"
                    android:text="@string/settings_v4_general_about" />

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/V4SettingsDivider" />

            <!-- Privacy -->
            <LinearLayout
                android:id="@+id/btnPrivacy"
                style="@style/V4SettingsRowSimple">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_shield" />

                <TextView
                    style="@style/V4SettingsRowSimpleLabel"
                    android:text="@string/settings_v4_general_privacy" />

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/V4SettingsDivider" />

            <!-- Export Report -->
            <LinearLayout
                android:id="@+id/btnExportReport"
                style="@style/V4SettingsRowSimple">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_eye" />

                <TextView
                    style="@style/V4SettingsRowSimpleLabel"
                    android:text="@string/settings_v4_general_export" />

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/V4SettingsDivider" />

            <!-- Breach Checker -->
            <LinearLayout
                android:id="@+id/btnBreachChecker"
                style="@style/V4SettingsRowSimple">

                <ImageView
                    style="@style/V4SettingsRowIcon"
                    android:src="@drawable/ic_glyph_eye" />

                <TextView
                    style="@style/V4SettingsRowSimpleLabel"
                    android:text="@string/settings_v4_general_breach" />

                <ImageView style="@style/V4SettingsRowChevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── Logout ─── -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_v4_surface"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_glyph_logout"
                app:tint="@color/v4_bad" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/montserrat"
                android:text="@string/settings_v4_logout"
                android:textColor="@color/v4_bad"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Version footer -->
        <TextView
            android:id="@+id/tvVersionFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:textColor="@color/v4_fg3"
            android:textSize="11sp"
            tools:text="S'CAN v1.4" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
