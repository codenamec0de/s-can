<?xml version="1.0" encoding="utf-8"?>
<!-- Active "Beta" tool card: a launchable tool card (icon + title + toggle, like
     item_home_tool_card) that additionally carries a cyan BETA pill beside the title.
     Bound by HomeFragment.bindToolCard exactly like the other active cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v4_tool_card_idle"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/toolIconTile"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_v4_perm_icon_tile">

        <ImageView
            android:id="@+id/toolIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/v4_fg2"
            tools:src="@drawable/ic_glyph_globe" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toolTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.015"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="13.5sp"
                tools:text="DNS Leak Detection" />

            <TextView
                android:id="@+id/toolBetaPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_v4_beta_pill"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.07"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/home_tool_beta_pill"
                android:textAllCaps="true"
                android:textColor="@color/v4_accent"
                android:textFontWeight="700"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/toolDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/montserrat"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/v4_fg2"
            android:textFontWeight="500"
            android:textSize="11.5sp"
            tools:text="Checks whether your DNS lookups are private — or visible to the network you're on." />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/toolToggle"
        android:layout_width="36dp"
        android:layout_height="22dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_v4_tool_toggle_off"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/toolToggleThumb"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_v4_tool_toggle_thumb_off" />
    </FrameLayout>
</LinearLayout>
