<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="-0.025"
                    android:text="@string/alerts_v4_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="26sp" />

                <FrameLayout
                    android:id="@+id/btnAlertsSettings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_v4_top_bar_button"
                    android:clickable="true"
                    android:contentDescription="@string/alerts_v4_settings_cd"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/v4_fg1" />
                </FrameLayout>
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:lineSpacingMultiplier="1.5"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp"
                android:text="@string/alerts_v4_subtitle"
                android:textColor="@color/v4_fg2"
                android:textFontWeight="500"
                android:textSize="12.5sp" />

            <!-- Summary metric card -->
            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_v4_surface"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.1"
                        android:text="@string/alerts_v4_metric_today"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tvMetricToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.025"
                        android:text="0"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="22sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/v4_hairline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.1"
                        android:text="@string/alerts_v4_metric_critical"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tvMetricCritical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.025"
                        android:text="0"
                        android:textColor="@color/v4_bad"
                        android:textFontWeight="600"
                        android:textSize="22sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/v4_hairline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.1"
                        android:text="@string/alerts_v4_metric_patterns"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tvMetricPatterns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.025"
                        android:text="0"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Segmented filter -->
            <LinearLayout
                android:id="@+id/filterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_v4_apps_segment_container"
                android:orientation="horizontal"
                android:padding="3dp">

                <FrameLayout
                    android:id="@+id/filterAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvFilterAllLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/alerts_v4_filter_all"
                            android:textColor="@color/v4_fg2"
                            android:textFontWeight="600"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvFilterAllCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:alpha="0.55"
                            android:fontFamily="monospace"
                            android:textColor="@color/v4_fg2"
                            android:textSize="11sp"
                            tools:text="12" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/filterCritical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvFilterCriticalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/alerts_v4_filter_critical"
                            android:textColor="@color/v4_fg2"
                            android:textFontWeight="600"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvFilterCriticalCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:alpha="0.55"
                            android:fontFamily="monospace"
                            android:textColor="@color/v4_fg2"
                            android:textSize="11sp"
                            tools:text="3" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/filterPatterns"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvFilterPatternsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/alerts_v4_filter_patterns"
                            android:textColor="@color/v4_fg2"
                            android:textFontWeight="600"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvFilterPatternsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:alpha="0.55"
                            android:fontFamily="monospace"
                            android:textColor="@color/v4_fg2"
                            android:textSize="11sp"
                            tools:text="2" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Groups container -->
            <LinearLayout
                android:id="@+id/groupsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- End-of-timeline footer -->
            <TextView
                android:id="@+id/tvEndOfTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/v4_fg3"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="End of timeline · 7 flagged of 10"
                tools:visibility="visible" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_v4_hero_icon_tile">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_bell"
                        app:tint="@color/v4_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="-0.015"
                    android:text="@string/alerts_v4_empty_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.55"
                    android:text="@string/alerts_v4_empty_desc"
                    android:textColor="@color/v4_fg2"
                    android:textFontWeight="500"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hidden legacy fields kept for binding compatibility -->
    <TextView
        android:id="@+id/tvAlertCount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnClearAlerts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlerts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
