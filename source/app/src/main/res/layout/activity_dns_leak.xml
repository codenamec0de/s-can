<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <!-- ──────────────────  Top bar  ────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/fp_back_cd"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v4_fg1" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.0125"
                android:text="@string/dns_v4_title"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="@string/dns_v4_subtitle"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="500"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnRefreshTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/dns_v4_btn_run_again"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_glyph_refresh"
                app:tint="@color/v4_fg2" />
        </FrameLayout>
    </LinearLayout>

    <!-- ──────────────────  Phase host  ────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ═══════════  EMPTY / FIRST-RUN  ═══════════ -->
        <LinearLayout
            android:id="@+id/phaseEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginBottom="26dp">

                    <View
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_v4_dns_hero_circle" />

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_globe"
                        app:tint="@color/v4_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:letterSpacing="-0.024"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/dns_v4_empty_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:maxWidth="290dp"
                    android:text="@string/dns_v4_empty_body"
                    android:textColor="@color/v4_fg2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_v4_perm_icon_tile">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_glyph_lock"
                                app:tint="@color/v4_fg2" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/dns_v4_empty_check_encrypted"
                            android:textColor="@color/v4_fg1"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_v4_perm_icon_tile">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_glyph_data"
                                app:tint="@color/v4_fg2" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/dns_v4_empty_check_resolver"
                            android:textColor="@color/v4_fg1"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_v4_perm_icon_tile">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_glyph_shield"
                                app:tint="@color/v4_fg2" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/dns_v4_empty_check_vpn"
                            android:textColor="@color/v4_fg1"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheck"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:fontFamily="@font/montserrat"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="@string/dns_v4_btn_check"
                    android:textAllCaps="false"
                    android:textFontWeight="600"
                    android:textSize="13.5sp"
                    app:icon="@drawable/ic_glyph_globe"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="@string/dns_v4_empty_footnote"
                    android:textColor="@color/v4_fg3"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════  SCANNING  ═══════════ -->
        <LinearLayout
            android:id="@+id/phaseScanning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="30dp"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginBottom="30dp">

                <com.uow.scan.ui.home.widget.RadarPulseView
                    android:id="@+id/radarPulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_v4_dns_hero_circle" />

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_glyph_globe"
                    app:tint="@color/v4_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.013"
                android:text="@string/dns_v4_scanning_title"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <include
                    android:id="@+id/step1"
                    layout="@layout/item_dns_scan_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxWidth="280dp" />

                <include
                    android:id="@+id/step2"
                    layout="@layout/item_dns_scan_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxWidth="280dp" />

                <include
                    android:id="@+id/step3"
                    layout="@layout/item_dns_scan_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxWidth="280dp" />

                <include
                    android:id="@+id/step4"
                    layout="@layout/item_dns_scan_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxWidth="280dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════  ERROR / OFFLINE  ═══════════ -->
        <LinearLayout
            android:id="@+id/phaseError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="36dp">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginBottom="22dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_v4_dns_error_circle" />

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_warn"
                        app:tint="@color/v4_warn" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:letterSpacing="-0.018"
                    android:text="@string/dns_v4_error_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:maxWidth="280dp"
                    android:text="@string/dns_v4_error_body"
                    android:textColor="@color/v4_fg2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTryAgain"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:fontFamily="@font/montserrat"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="@string/dns_v4_btn_try_again"
                    android:textAllCaps="false"
                    android:textFontWeight="600"
                    android:textSize="13.5sp"
                    app:icon="@drawable/ic_glyph_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════  RESULT  ═══════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/phaseResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="30dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Verdict hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_v4_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp">

                        <com.uow.scan.ui.home.widget.WifiScoreGaugeView
                            android:id="@+id/dnsGauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.04"
                                android:textColor="@color/v4_fg0"
                                android:textFontWeight="600"
                                android:textSize="25sp"
                                tools:text="34" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.06"
                                android:text="@string/dns_v4_score_unit"
                                android:textColor="@color/v4_fg3"
                                android:textFontWeight="600"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/gradeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            tools:background="@drawable/bg_v4_perm_pill_bad">

                            <View
                                android:id="@+id/gradeDot"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_v4_dns_dot"
                                android:backgroundTint="@color/v4_bad" />

                            <TextView
                                android:id="@+id/tvGrade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:letterSpacing="0.1"
                                android:textAllCaps="true"
                                android:textFontWeight="700"
                                android:textSize="10sp"
                                tools:text="Exposed"
                                tools:textColor="@color/v4_bad" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVerdictLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/montserrat"
                            android:letterSpacing="-0.018"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/v4_fg0"
                            android:textFontWeight="600"
                            android:textSize="16sp"
                            tools:text="Your network can see every site you visit." />

                        <TextView
                            android:id="@+id/tvResolverProto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/v4_fg3"
                            android:textSize="11sp"
                            tools:text="unencrypted · Your router" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Resolver summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:text="@string/dns_v4_section_resolver"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileResolver"
                        layout="@layout/item_dns_resolver_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileEncrypted"
                        layout="@layout/item_dns_resolver_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileNetwork"
                        layout="@layout/item_dns_resolver_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileVpn"
                        layout="@layout/item_dns_resolver_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Reassuring banner (clean state) -->
                <LinearLayout
                    android:id="@+id/cleanBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_v4_status_card_ok"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_check"
                        app:tint="@color/v4_ok" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/dns_v4_clean_banner"
                        android:textColor="@color/v4_fg1"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Findings -->
                <TextView
                    android:id="@+id/tvFindingsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp"
                    tools:text="Findings · 3 of 3 need attention" />

                <LinearLayout
                    android:id="@+id/findingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical" />

                <!-- Remediation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrimary"
                        style="@style/V4.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:fontFamily="@font/montserrat"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="13.5sp"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/v4_bg"
                        tools:icon="@drawable/ic_glyph_lock"
                        tools:text="Turn on Private DNS" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondary"
                        style="@style/V4.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:fontFamily="@font/montserrat"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="13.5sp"
                        app:icon="@drawable/ic_glyph_refresh"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/v4_fg1"
                        tools:text="Run check again" />
                </LinearLayout>

                <!-- Advanced / Deep test -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:text="@string/dns_v4_section_advanced"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:id="@+id/cardDeepTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_v4_dns_deeptest"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_v4_perm_icon_tile">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_glyph_globe"
                            app:tint="@color/v4_fg2" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:letterSpacing="-0.015"
                                android:text="@string/dns_v4_deeptest_title"
                                android:textColor="@color/v4_fg1"
                                android:textFontWeight="600"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_v4_beta_pill"
                                android:fontFamily="@font/montserrat"
                                android:letterSpacing="0.07"
                                android:paddingStart="6dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="6dp"
                                android:paddingBottom="2dp"
                                android:text="@string/dns_v4_deeptest_badge"
                                android:textAllCaps="true"
                                android:textColor="@color/v4_accent"
                                android:textFontWeight="700"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/montserrat"
                            android:lineSpacingMultiplier="1.45"
                            android:text="@string/dns_v4_deeptest_body"
                            android:textColor="@color/v4_fg3"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_arrow_right"
                        app:tint="@color/v4_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/dns_v4_footer"
                    android:textColor="@color/v4_fg3"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
