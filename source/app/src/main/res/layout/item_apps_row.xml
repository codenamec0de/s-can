<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v4_apps_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="13dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_v4_apps_initial_tile"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="App icon"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvAppInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/v4_fg1"
            android:textFontWeight="600"
            android:textSize="13sp"
            tools:text="f" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.005"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="13.5sp"
                tools:text="Facebook" />

            <TextView
                android:id="@+id/tvAppSevPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.08"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:textAllCaps="true"
                android:textFontWeight="700"
                android:textSize="9.5sp"
                android:visibility="gone"
                tools:background="@drawable/bg_v4_perm_pill_warn"
                tools:text="Flag"
                tools:textColor="@color/v4_warn"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/v4_fg3"
            android:textFontWeight="500"
            android:textSize="11.5sp"
            tools:text="Background location · 3× this week"
            tools:textColor="@color/v4_bad" />
    </LinearLayout>

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_glyph_chevron"
        app:tint="@color/v4_fg3" />
</LinearLayout>
