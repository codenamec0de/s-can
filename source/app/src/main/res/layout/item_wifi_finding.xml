<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_v4_surface"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/sevTile"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/bg_v4_breach_tile_warn">

        <ImageView
            android:id="@+id/sevIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_glyph_warn"
            app:tint="@color/v4_warn" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFindingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.014"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="13.5sp"
                tools:text="No Management Frame Protection (PMF)" />

            <TextView
                android:id="@+id/tvSeverityPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.067"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAllCaps="true"
                android:textFontWeight="700"
                android:textSize="9.5sp"
                tools:background="@drawable/bg_v4_perm_pill_warn"
                tools:text="Medium"
                tools:textColor="@color/v4_warn" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFindingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/v4_fg2"
            android:textSize="11.5sp"
            tools:text="802.11w is disabled. An attacker in range can send forged deauth/disassoc frames to disconnect you and stage MITM attacks." />

        <LinearLayout
            android:id="@+id/fixBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_v4_perm_tag"
            android:orientation="horizontal"
            android:paddingHorizontal="11dp"
            android:paddingVertical="9dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_glyph_arrow_right"
                app:tint="@color/v4_accent" />

            <TextView
                android:id="@+id/tvFindingFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/v4_fg1"
                android:textSize="11sp"
                tools:text="Enable PMF on the router and, if possible, use a WPA3 network." />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
