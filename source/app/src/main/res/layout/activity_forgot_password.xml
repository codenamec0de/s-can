<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:fitsSystemWindows="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_v4_perm_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fp_back_cd"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/v4_fg1" />
            </LinearLayout>

            <!-- Icon tile + hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="14dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_v4_fp_icon_tile">

                    <ImageView
                        android:id="@+id/ivHeroIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_lock"
                        app:tint="@color/v4_accent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="-0.03"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/fp_step1_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/montserrat"
                    android:lineSpacingMultiplier="1.55"
                    android:text="@string/fp_step1_subtitle"
                    android:textColor="@color/v4_fg2"
                    android:textFontWeight="500"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============ STEP 1 ============ -->
            <LinearLayout
                android:id="@+id/stepOneContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/fp_email_label"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_v4_field_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/ivEmailIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_email"
                        app:tint="@color/v4_fg3" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="emailAddress"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat"
                        android:hint="@string/fp_email_placeholder"
                        android:importantForAutofill="yes"
                        android:inputType="textEmailAddress"
                        android:letterSpacing="-0.005"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textColorHint="@color/v4_fg3"
                        android:textFontWeight="500"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmailFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/fp_email_hint"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="500"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:enabled="false"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="-0.005"
                    android:text="@string/fp_send_cta"
                    android:textFontWeight="600"
                    app:icon="@drawable/ic_glyph_arrow_right"
                    app:iconGravity="end"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/fp_remember_prefix"
                        android:textColor="@color/v4_fg2"
                        android:textFontWeight="500"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvBackToSignIn1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/fp_remember_link"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ STEP 2 ============ -->
            <LinearLayout
                android:id="@+id/stepTwoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="28dp"
                android:visibility="gone">

                <!-- Inbox preview card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_v4_fp_inbox_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_v4_fp_inbox_logo">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_v4_wordmark"
                                app:tint="@color/v4_accent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:text="@string/fp_inbox_sender"
                                android:textColor="@color/v4_fg0"
                                android:textFontWeight="600"
                                android:textSize="12.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="monospace"
                                android:text="@string/fp_inbox_meta"
                                android:textColor="@color/v4_fg3"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_v4_perm_pill_ok"
                            android:fontFamily="@font/montserrat"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:text="@string/fp_inbox_pill"
                            android:textAllCaps="true"
                            android:textColor="@color/v4_ok"
                            android:textFontWeight="700"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="-0.005"
                        android:text="@string/fp_inbox_subject"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/fp_inbox_body"
                        android:textColor="@color/v4_fg2"
                        android:textFontWeight="500"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- What to do next -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/fp_steps_label"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_v4_fp_step_bubble">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="monospace"
                            android:text="1"
                            android:textColor="@color/v4_accent"
                            android:textFontWeight="700"
                            android:textSize="10sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/fp_step_1"
                        android:textColor="@color/v4_fg1"
                        android:textFontWeight="500"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_v4_fp_step_bubble">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="monospace"
                            android:text="2"
                            android:textColor="@color/v4_accent"
                            android:textFontWeight="700"
                            android:textSize="10sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/fp_step_2"
                        android:textColor="@color/v4_fg1"
                        android:textFontWeight="500"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_v4_fp_step_bubble">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="monospace"
                            android:text="3"
                            android:textColor="@color/v4_accent"
                            android:textFontWeight="700"
                            android:textSize="10sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/fp_step_3"
                        android:textColor="@color/v4_fg1"
                        android:textFontWeight="500"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Resend row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_v4_fp_resend_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvResendStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.4"
                        android:text="@string/fp_resend_default"
                        android:textColor="@color/v4_fg2"
                        android:textFontWeight="500"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvResendAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/fp_resend_action"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToSignIn"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="-0.005"
                    android:text="@string/fp_back_to_signin"
                    android:textFontWeight="600"
                    app:icon="@drawable/ic_glyph_arrow_right"
                    app:iconGravity="end"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/fp_wrong_email_prefix"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="500"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvWrongEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/fp_wrong_email_link"
                        android:textColor="@color/v4_fg1"
                        android:textFontWeight="600"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom privacy footer (reserves its own space) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:paddingHorizontal="28dp"
        android:paddingBottom="24dp"
        android:paddingTop="14dp"
        android:text="@string/fp_privacy_footer"
        android:textColor="@color/v4_fg3"
        android:textFontWeight="500"
        android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
