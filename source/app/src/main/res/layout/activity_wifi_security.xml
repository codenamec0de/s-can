<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <!-- ──────────────────  Top bar  ────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/fp_back_cd"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v4_fg1" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="-0.0125"
            android:text="@string/wifi_v4_title"
            android:textColor="@color/v4_fg0"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/btnRescanTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/wifi_v4_btn_rescan"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_glyph_refresh"
                app:tint="@color/v4_fg2" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ──────────────────  Permission prompt (only when missing)  ────────────────── -->
            <LinearLayout
                android:id="@+id/cardPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_status_card_warn"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:text="@string/wifi_v4_perm_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_warn"
                    android:textFontWeight="700"
                    android:textSize="10.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/wifi_v4_perm_body"
                    android:textColor="@color/v4_fg0"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermission"
                    style="@style/V4.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat"
                    android:paddingHorizontal="16dp"
                    android:text="@string/wifi_v4_btn_grant"
                    android:textAllCaps="false"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ──────────────────  Hero  ────────────────── -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">

                    <com.uow.scan.ui.home.widget.WifiScoreGaugeView
                        android:id="@+id/scoreGauge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.04"
                            android:textColor="@color/v4_fg0"
                            android:textFontWeight="600"
                            android:textSize="24sp"
                            tools:text="52" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.06"
                            android:text="@string/wifi_v4_score_unit"
                            android:textColor="@color/v4_fg3"
                            android:textFontWeight="600"
                            android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivWifiIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_glyph_wifi"
                            app:tint="@color/v4_accent" />

                        <TextView
                            android:id="@+id/tvHeroEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/montserrat"
                            android:letterSpacing="0.15"
                            android:text="@string/wifi_v4_eyebrow_connected"
                            android:textAllCaps="true"
                            android:textColor="@color/v4_accent"
                            android:textFontWeight="700"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSsid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="-0.018"
                        android:lineSpacingMultiplier="1.25"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="17sp"
                        tools:text="Charlie's Glorious NBN_5G" />

                    <TextView
                        android:id="@+id/tvNetworkSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/v4_fg3"
                        android:textSize="11sp"
                        tools:text="WPA2-Personal · 5 GHz · −45 dBm" />

                    <TextView
                        android:id="@+id/tvGrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.12"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textAllCaps="true"
                        android:textFontWeight="700"
                        android:textSize="10sp"
                        tools:background="@drawable/bg_v4_perm_pill_warn"
                        tools:text="POOR"
                        tools:textColor="@color/v4_warn" />
                </LinearLayout>
            </LinearLayout>

            <!-- ──────────────────  Metric strip  ────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_v4_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.12"
                        android:text="@string/wifi_v4_metric_cipher"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tvCipher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.018"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="17sp"
                        tools:text="CCMP" />

                    <TextView
                        android:id="@+id/tvCipherSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:text="@string/wifi_v4_metric_cipher_sub"
                        android:textColor="@color/v4_fg3"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_v4_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.12"
                        android:text="@string/wifi_v4_metric_pmf"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tvPmf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.018"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="17sp"
                        tools:text="Off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:text="@string/wifi_v4_metric_pmf_sub"
                        android:textColor="@color/v4_fg3"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_v4_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.12"
                        android:text="@string/wifi_v4_metric_signal"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/tvSignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.018"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="17sp"
                        tools:text="−45" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:text="@string/wifi_v4_metric_signal_sub"
                        android:textColor="@color/v4_fg3"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ──────────────────  Findings  ────────────────── -->
            <TextView
                android:id="@+id/tvFindingsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.13"
                android:text="@string/wifi_v4_section_findings"
                android:textAllCaps="true"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="600"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/findingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical" />

            <!-- Legacy view kept as no-op for binding compat -->
            <TextView
                android:id="@+id/tvFindingsSub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- ──────────────────  Network details  ────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.13"
                android:text="@string/wifi_v4_section_details"
                android:textAllCaps="true"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="600"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/detailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:orientation="vertical"
                android:paddingVertical="6dp" />

            <!-- Legacy hidden TextView for binding compat -->
            <TextView
                android:id="@+id/tvDetails"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- ──────────────────  Actions  ────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRescan"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    app:icon="@drawable/ic_glyph_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg"
                    android:fontFamily="@font/montserrat"
                    android:text="@string/wifi_v4_btn_rescan_full"
                    android:textAllCaps="false"
                    android:textFontWeight="600"
                    android:textSize="13.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/V4.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    app:icon="@drawable/ic_glyph_document"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_fg1"
                    android:fontFamily="@font/montserrat"
                    android:text="@string/wifi_v4_btn_export"
                    android:textAllCaps="false"
                    android:textFontWeight="600"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:textColor="@color/v4_fg3"
                android:textSize="10.5sp"
                tools:text="Last scan · 14 min ago" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
