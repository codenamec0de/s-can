<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <!-- ──────────────────  Top bar  ────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/fp_back_cd"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v4_fg1" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.0125"
                android:text="@string/wifi_v4_title"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTopSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/v4_fg3"
                android:textSize="11sp"
                tools:text="8 networks in range" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnRescanTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/wifi_v4_btn_rescan"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivRescanIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_glyph_refresh"
                app:tint="@color/v4_fg2" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ──────────────────  Permission prompt (only when missing)  ────────────────── -->
            <LinearLayout
                android:id="@+id/cardPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_status_card_warn"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:text="@string/wifi_v4_perm_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_warn"
                    android:textFontWeight="700"
                    android:textSize="10.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/wifi_v4_perm_body"
                    android:textColor="@color/v4_fg0"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermission"
                    style="@style/V4.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/wifi_v4_btn_grant"
                    android:textAllCaps="false"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ──────────────────  Connected network hero (tappable → detail)  ────────────────── -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp">

                        <com.uow.scan.ui.home.widget.WifiScoreGaugeView
                            android:id="@+id/heroGauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHeroScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.05"
                                android:textColor="@color/v4_fg0"
                                android:textFontWeight="600"
                                android:textSize="20sp"
                                tools:text="52" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.05"
                                android:text="@string/wifi_v4_score_unit"
                                android:textColor="@color/v4_fg3"
                                android:textFontWeight="600"
                                android:textSize="7.5sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_glyph_wifi"
                                app:tint="@color/v4_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/montserrat"
                                android:letterSpacing="0.15"
                                android:text="@string/wifi_v4_eyebrow_connected"
                                android:textAllCaps="true"
                                android:textColor="@color/v4_accent"
                                android:textFontWeight="700"
                                android:textSize="9.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHeroSsid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat"
                            android:letterSpacing="-0.018"
                            android:maxLines="1"
                            android:textColor="@color/v4_fg0"
                            android:textFontWeight="600"
                            android:textSize="16sp"
                            tools:text="Charlie's Glorious NBN_5G" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeroGrade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:letterSpacing="0.1"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textAllCaps="true"
                                android:textFontWeight="700"
                                android:textSize="9.5sp"
                                tools:background="@drawable/bg_v4_perm_pill_warn"
                                tools:text="POOR"
                                tools:textColor="@color/v4_warn" />

                            <TextView
                                android:id="@+id/tvHeroSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:textColor="@color/v4_fg3"
                                android:textSize="10.5sp"
                                tools:text="WPA2 · −45 dBm" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="top"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_chevron"
                        app:tint="@color/v4_fg3" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/v4_hairline" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_document"
                        app:tint="@color/v4_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/wifi_v4_view_full_report"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ──────────────────  Not-connected hero placeholder  ────────────────── -->
            <LinearLayout
                android:id="@+id/heroDisconnected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_glyph_wifi"
                    app:tint="@color/v4_fg3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/wifi_v4_no_network"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/wifi_v4_connect_prompt"
                        android:textColor="@color/v4_fg3"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ──────────────────  Threat banner  ────────────────── -->
            <LinearLayout
                android:id="@+id/threatBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_status_card_bad"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_v4_breach_tile_bad">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_warn"
                        app:tint="@color/v4_bad" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvThreatTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/v4_bad"
                        android:textFontWeight="700"
                        android:textSize="12.5sp"
                        tools:text="2 nearby networks need attention" />

                    <TextView
                        android:id="@+id/tvThreatBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/v4_fg1"
                        android:textSize="11sp"
                        tools:text="A duplicate of your network name was detected — possible evil twin." />
                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_glyph_chevron"
                    app:tint="@color/v4_bad" />
            </LinearLayout>

            <!-- ──────────────────  Nearby header + sort  ────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNearbyHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp"
                    tools:text="Nearby networks · 8" />

                <LinearLayout
                    android:id="@+id/sortControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:letterSpacing="0.03"
                        android:text="@string/wifi_v4_sort_label"
                        android:textColor="@color/v4_fg4"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/btnSortSignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_v4_perm_pill_accent"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserrat"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="@string/wifi_v4_sort_signal"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/btnSortRisk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserrat"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="@string/wifi_v4_sort_risk"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ──────────────────  Nearby list  ────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_wifi_network_row" />

            <!-- ──────────────────  Empty state  ────────────────── -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:text="@string/wifi_v4_no_nearby"
                android:textColor="@color/v4_fg3"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ──────────────────  Scanning state  ────────────────── -->
            <LinearLayout
                android:id="@+id/scanningState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="46dp"
                android:paddingBottom="40dp"
                android:visibility="gone"
                tools:visibility="gone">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <com.uow.scan.ui.home.widget.RadarPulseView
                        android:id="@+id/radar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_v4_wifi_scan_disc">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_glyph_wifi"
                            app:tint="@color/v4_accent" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/montserrat"
                    android:text="@string/wifi_v4_scanning_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="monospace"
                    android:text="@string/wifi_v4_scanning_sub"
                    android:textColor="@color/v4_fg3"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ──────────────────  Footer  ────────────────── -->
            <TextView
                android:id="@+id/tvLastScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:text="@string/wifi_v4_overview_footer"
                android:textColor="@color/v4_fg3"
                android:textSize="10.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
