<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v4_surface"
    android:orientation="vertical"
    android:paddingHorizontal="13dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_glyph_data"
            app:tint="@color/v4_fg3" />

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="0.11"
            android:textAllCaps="true"
            android:textColor="@color/v4_fg3"
            android:textFontWeight="600"
            android:textSize="9.5sp"
            tools:text="Resolver" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/montserrat"
        android:letterSpacing="-0.013"
        android:maxLines="1"
        android:textColor="@color/v4_fg0"
        android:textFontWeight="600"
        android:textSize="15sp"
        tools:text="Your router" />

    <TextView
        android:id="@+id/tileSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.013"
        android:maxLines="1"
        android:textColor="@color/v4_fg3"
        android:textSize="10sp"
        tools:text="192.168.0.1" />
</LinearLayout>
