<?xml version="1.0" encoding="utf-8"?>
<!-- Shared V4-styled dialog content: rounded dark surface, montserrat, accent buttons.
     Rows toggle visibility per dialog type (message for confirms, input for prompts). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v4_surface"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat"
        android:letterSpacing="-0.015"
        android:textColor="@color/v4_fg0"
        android:textFontWeight="600"
        android:textSize="19sp"
        tools:text="Add monitored address" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/montserrat"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/v4_fg2"
        android:textFontWeight="500"
        android:textSize="13.5sp"
        android:visibility="gone"
        tools:text="Remove this address from monitoring?"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_v4_field_neutral"
        android:fontFamily="@font/montserrat"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/v4_fg0"
        android:textColorHint="@color/v4_fg3"
        android:textSize="14.5sp"
        android:visibility="gone"
        tools:text="name@example.com"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogCancel"
            style="@style/V4.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogConfirm"
            style="@style/V4.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="20dp"
            tools:text="Add" />
    </LinearLayout>
</LinearLayout>
