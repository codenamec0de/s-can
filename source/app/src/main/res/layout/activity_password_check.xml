<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <!-- ───── top bar (title + subtitle) ───── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v4_fg1" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.0125"
                android:text="@string/breach_pw_title"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/breach_pw_subtitle"
                android:textColor="@color/v4_fg3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ═══════════ PHASE: INPUT ═══════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/phaseInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="500dp"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- privacy hero -->
                <FrameLayout
                    android:id="@+id/pwHeroTile"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_key"
                        app:tint="@color/v4_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:text="@string/breach_pw_hero_title"
                    android:textColor="@color/v4_fg0"
                    android:textFontWeight="600"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="24dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/breach_pw_hero_sub"
                    android:textColor="@color/v4_fg2"
                    android:textSize="12.5sp" />

                <!-- input field -->
                <LinearLayout
                    android:id="@+id/pwInputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginHorizontal="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_lock"
                        app:tint="@color/v4_fg3" />

                    <EditText
                        android:id="@+id/pwField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="@null"
                        android:background="@null"
                        android:fontFamily="monospace"
                        android:hint="@string/breach_pw_input_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingVertical="12dp"
                        android:textColor="@color/v4_fg0"
                        android:textColorHint="@color/v4_fg3"
                        android:textSize="15sp"
                        tools:ignore="LabelFor" />

                    <FrameLayout
                        android:id="@+id/pwEyeBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/pwEyeIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_glyph_eye"
                            app:tint="@color/v4_fg3" />
                    </FrameLayout>
                </LinearLayout>

                <!-- privacy line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginHorizontal="22dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_shield"
                        app:tint="@color/v4_accent" />

                    <TextView
                        android:id="@+id/pwPrivacyLine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/v4_fg2"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- live strength meter (shown when there is input) -->
                <FrameLayout
                    android:id="@+id/pwMeterSlotInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_v4_surface"
                    android:padding="14dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pwBtnCheck"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/breach_pw_btn_check"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_glyph_shield"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/breach_pw_microcopy"
                    android:textColor="@color/v4_fg3"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══════════ PHASE: CHECKING ═══════════ -->
        <LinearLayout
            android:id="@+id/phaseChecking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="50dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp">

                <com.uow.scan.ui.home.widget.RadarPulseView
                    android:id="@+id/pwRadar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/pwCheckingTile"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_lock"
                        app:tint="@color/v4_accent" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/montserrat"
                android:text="@string/breach_pw_checking_title"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/breach_pw_checking_sub"
                android:textColor="@color/v4_fg3"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- ═══════════ PHASE: RESULT / OFFLINE ═══════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/phaseResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- verdict hero -->
                <LinearLayout
                    android:id="@+id/pwVerdictCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_v4_surface"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/pwVerdictDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp" />

                        <TextView
                            android:id="@+id/pwVerdictState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/montserrat"
                            android:letterSpacing="0.13"
                            android:textAllCaps="true"
                            android:textFontWeight="700"
                            android:textSize="10.5sp"
                            tools:text="Breached"
                            tools:textColor="@color/v4_bad" />
                    </LinearLayout>

                    <!-- breached: big count -->
                    <LinearLayout
                        android:id="@+id/pwCountBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/pwBreachCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="-0.04"
                            android:textFontWeight="700"
                            android:textSize="38sp"
                            tools:text="52,256,179"
                            tools:textColor="@color/v4_bad" />

                        <TextView
                            android:id="@+id/pwBreachCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/breach_pw_breached_caption"
                            android:textColor="@color/v4_fg2"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- non-breached: headline + sub -->
                    <LinearLayout
                        android:id="@+id/pwHeadlineBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/pwVerdictHeadline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:letterSpacing="-0.02"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="@color/v4_fg0"
                            android:textFontWeight="600"
                            android:textSize="19sp"
                            tools:text="Not in any known breach, and strong" />

                        <TextView
                            android:id="@+id/pwVerdictSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/montserrat"
                            android:lineSpacingMultiplier="1.45"
                            android:textColor="@color/v4_fg2"
                            android:textSize="12.5sp"
                            tools:text="Estimated time to crack: 3 centuries." />
                    </LinearLayout>
                </LinearLayout>

                <!-- guidance -->
                <LinearLayout
                    android:id="@+id/pwGuidanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="20dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/pwGuidanceIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_glyph_warn" />

                    <TextView
                        android:id="@+id/pwGuidanceText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.55"
                        android:textColor="@color/v4_fg1"
                        android:textSize="12sp"
                        tools:text="Attackers already have this." />
                </LinearLayout>

                <!-- credential-stuffing education (breached only) -->
                <TextView
                    android:id="@+id/pwCredStuffing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="22dp"
                    android:fontFamily="@font/montserrat"
                    android:lineSpacingMultiplier="1.55"
                    android:textColor="@color/v4_fg3"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    tools:text="Once a password leaks…" />

                <!-- strength companion -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="22dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.09"
                    android:text="@string/breach_pw_strength_section"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="11sp" />

                <FrameLayout
                    android:id="@+id/pwMeterSlotResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_v4_surface"
                    android:padding="15dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pwBtnRetry"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/breach_pw_action_retry"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:icon="@drawable/ic_glyph_refresh"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pwBtnAnother"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/breach_pw_action_another"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_glyph_key"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/breach_pw_microcopy"
                    android:textColor="@color/v4_fg3"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
