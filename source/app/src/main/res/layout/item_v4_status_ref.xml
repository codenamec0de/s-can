<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_v4_surface"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/refIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_glyph_warn"
            tools:tint="@color/v4_warn" />

        <TextView
            android:id="@+id/refTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat"
            android:textFontWeight="600"
            android:textSize="12.5sp"
            tools:text="Authentication failed"
            tools:textColor="@color/v4_warn" />
    </LinearLayout>

    <TextView
        android:id="@+id/refDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/montserrat"
        android:lineSpacingMultiplier="1.45"
        android:textColor="@color/v4_fg2"
        android:textFontWeight="500"
        android:textSize="11.5sp"
        tools:text="Server returned 401. Token may be wrong or expired." />
</LinearLayout>
