<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_v4_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ───────────────────  Hero status surface  ─────────────────── -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/heroDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_v4_sev_dot_ok" />

                    <TextView
                        android:id="@+id/tvHeroEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.13"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="10.5sp"
                        tools:text="No checks yet" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHeroEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/v4_fg2"
                    android:textSize="13sp"
                    tools:text="john@uow.edu.au" />

                <TextView
                    android:id="@+id/tvHeroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/v4_fg3"
                    android:textSize="11sp"
                    tools:text="Last checked · 14 minutes ago" />

                <!-- Hero actions: Re-scan + Add address (visible when configured) -->
                <LinearLayout
                    android:id="@+id/heroActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRescan"
                        style="@style/V4.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/breach_v4_btn_rescan"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_glyph_refresh"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/v4_bg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddAddress"
                        style="@style/V4.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/breach_v4_btn_add_address"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ───────────────────  Private Password Check entry  ─────────────────── -->
            <LinearLayout
                android:id="@+id/pwEntryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_pw_step_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_key"
                        app:tint="@color/v4_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="-0.02"
                        android:text="@string/breach_pw_entry_title"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.45"
                        android:text="@string/breach_pw_entry_sub"
                        android:textColor="@color/v4_fg2"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_glyph_chevron"
                    app:tint="@color/v4_fg3" />
            </LinearLayout>

            <!-- ───────────────────  Credentials section (only when no API key)  ─────────────────── -->
            <LinearLayout
                android:id="@+id/credentialsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:text="@string/breach_v4_section_credentials"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_v4_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/breach_v4_email_hint"
                        app:boxBackgroundColor="@color/v4_surf3"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/v4_accent"
                        app:hintTextColor="@color/v4_fg3">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/v4_fg0"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/breach_v4_apikey_hint"
                        app:boxBackgroundColor="@color/v4_surf3"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/v4_accent"
                        app:hintTextColor="@color/v4_fg3">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/v4_fg0"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/breach_v4_apikey_help"
                        android:textColor="@color/v4_fg3"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheck"
                        style="@style/V4.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/montserrat"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0.01"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/breach_v4_btn_save_check"
                        android:textAllCaps="false"
                        android:textFontWeight="600"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ───────────────────  Monitored addresses (only when configured)  ─────────────────── -->
            <LinearLayout
                android:id="@+id/monitoredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.13"
                    android:text="@string/breach_v4_section_addresses"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:id="@+id/monitoredList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_v4_surface"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ───────────────────  Loading / status  ─────────────────── -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/v4_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:textColor="@color/v4_fg2"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ───────────────────  Breach history  ─────────────────── -->
            <TextView
                android:id="@+id/tvHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.13"
                android:text="@string/breach_v4_section_history"
                android:textAllCaps="true"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="600"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <View
                android:id="@+id/cardSummary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBreachCount"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBreachLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/breachList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical" />

            <!-- ───────────────────  HIBP attribution  ─────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="30dp"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/breach_v4_attribution"
                android:textColor="@color/v4_fg3"
                android:textSize="10.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
