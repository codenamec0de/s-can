<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_v4_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Identity card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_v4_settings_profile_tile"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/ivProfileBigPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Profile picture"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvProfileBigInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="22sp"
                        tools:text="J" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="-0.013"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="15sp"
                        tools:text="John Doe" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg3"
                        android:textSize="11.5sp"
                        tools:text="john@uow.edu.au" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_v4_button_secondary"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:paddingStart="16dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="9dp"
                        android:text="@string/profile_v4_btn_edit"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="12sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Account section -->
            <TextView
                style="@style/V4SettingsSectionLabel"
                android:text="@string/profile_v4_section_account" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowEmail"
                    style="@style/V4SettingsRow">

                    <ImageView
                        style="@style/V4SettingsRowIcon"
                        android:src="@drawable/ic_v4_glyph_storage" />

                    <TextView
                        style="@style/V4SettingsRowSimpleLabel"
                        android:text="@string/profile_v4_row_email" />

                    <TextView
                        android:id="@+id/tvProfileEmailValue"
                        style="@style/V4MonoValue"
                        tools:text="john@uow.edu.au" />
                </LinearLayout>

                <View style="@style/V4SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowPassword"
                    style="@style/V4SettingsRow">

                    <ImageView
                        style="@style/V4SettingsRowIcon"
                        android:src="@drawable/ic_glyph_lock" />

                    <LinearLayout style="@style/V4SettingsRowText">

                        <TextView
                            style="@style/V4SettingsRowTitle"
                            android:text="@string/profile_v4_row_password" />

                        <TextView
                            android:id="@+id/tvPasswordMeta"
                            style="@style/V4SettingsRowDesc"
                            tools:text="Updated 14 d ago" />
                    </LinearLayout>

                    <ImageView style="@style/V4SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/V4SettingsDivider" />

                <LinearLayout
                    android:id="@+id/row2fa"
                    style="@style/V4SettingsRow">

                    <ImageView
                        style="@style/V4SettingsRowIcon"
                        android:src="@drawable/ic_glyph_shield" />

                    <TextView
                        style="@style/V4SettingsRowSimpleLabel"
                        android:text="@string/profile_v4_row_2fa" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch2fa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Two-factor auth" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sessions -->
            <TextView
                style="@style/V4SettingsSectionLabel"
                android:text="@string/profile_v4_section_sessions" />

            <LinearLayout
                android:id="@+id/sessionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_v4_surface"
                android:clipToOutline="true"
                android:orientation="vertical" />

            <!-- Delete account -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnDeleteAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_v4_button_danger"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/V4ButtonLabelDanger"
                        android:text="@string/profile_v4_btn_delete" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/profile_v4_delete_helper"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="500"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
