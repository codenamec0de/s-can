<?xml version="1.0" encoding="utf-8"?>
<!--
  V4 splash. One job: show the ScanLogo on the same dark backdrop as the rest
  of the app while we decide where to route on launch. No tagline, no spinner —
  the navigation handler in SplashActivity does the waiting.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/scan_logo" />
</FrameLayout>
