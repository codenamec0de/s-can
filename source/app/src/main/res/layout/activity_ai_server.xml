<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:orientation="vertical">

    <!-- TopBar: back + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_v4_top_bar_button"
            android:clickable="true"
            android:contentDescription="@string/fp_back_cd"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v4_fg1" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat"
            android:letterSpacing="-0.0125"
            android:text="@string/ai_server_title"
            android:textColor="@color/v4_fg0"
            android:textFontWeight="600"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:layout_marginTop="2dp"
                android:lineSpacingMultiplier="1.55"
                android:text="@string/ai_server_desc"
                android:textColor="@color/v4_fg2"
                android:textFontWeight="500"
                android:textSize="12.5sp" />

            <!-- Status alert card -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_v4_status_card_bad"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_v4_sev_dot_bad" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/ai_server_status_unreachable"
                        android:textColor="@color/v4_bad"
                        android:textFontWeight="600"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvStatusMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/v4_fg2"
                        android:textSize="11sp"
                        tools:text="Last checked 30s ago · Connection timed out" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnStatusRefresh"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:clickable="true"
                    android:contentDescription="@string/ai_server_test"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:src="@drawable/ic_glyph_refresh"
                    app:tint="@color/v4_fg2" />
            </LinearLayout>

            <!-- Server URL field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.1"
                android:text="@string/ai_server_url_label"
                android:textAllCaps="true"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="600"
                android:textSize="10.5sp" />

            <FrameLayout
                android:id="@+id/serverUrlField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_v4_field_neutral">

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="url"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="@string/ai_server_url_placeholder"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp"
                    android:textColor="@color/v4_fg0"
                    android:textColorHint="@color/v4_fg3"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUrlError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/v4_bad"
                android:textFontWeight="500"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Connection timed out — is the server running?"
                tools:visibility="visible" />

            <!-- Bearer token field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.1"
                android:text="@string/ai_server_token_label"
                android:textAllCaps="true"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="600"
                android:textSize="10.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_v4_field_neutral">

                <EditText
                    android:id="@+id/etServerToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="@string/ai_server_token_placeholder"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="11dp"
                    android:textColor="@color/v4_fg0"
                    android:textColorHint="@color/v4_fg3"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnToggleToken"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/ai_server_show_token_cd"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_glyph_eye"
                    app:tint="@color/v4_fg3" />
            </FrameLayout>

            <!-- Save -->
            <FrameLayout
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_v4_button_primary"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.0075"
                    android:paddingStart="16dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="13dp"
                    android:text="@string/ai_server_save"
                    android:textColor="@color/white"
                    android:textFontWeight="600"
                    android:textSize="13.5sp" />
            </FrameLayout>

            <!-- Status reference -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.13"
                android:paddingTop="22dp"
                android:paddingBottom="10dp"
                android:text="@string/ai_server_status_reference"
                android:textAllCaps="true"
                android:textColor="@color/v4_fg3"
                android:textFontWeight="600"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/refContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
