<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v4_bg"
    android:fitsSystemWindows="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@drawable/bg_v4_signup_glow" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="14dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/su_back_cd"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/v4_fg1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStepCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="1"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="monospace"
                        android:text="/ 2"
                        android:textColor="@color/v4_fg3"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress bar (2 segments) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="28dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/progressSeg1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_v4_perm_progress_fill" />

                <View
                    android:id="@+id/progressSeg2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_v4_strength_segment" />
            </LinearLayout>

            <!-- Title + subtitle -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/su_step1_title"
                android:textColor="@color/v4_fg0"
                android:textFontWeight="600"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserrat"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/su_step1_subtitle"
                android:textColor="@color/v4_fg2"
                android:textFontWeight="500"
                android:textSize="13sp" />

            <!-- ============ STEP 1 ============ -->
            <LinearLayout
                android:id="@+id/stepOneContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="28dp">

                <!-- Name label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/su_name_label"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <!-- Name field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_v4_field_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/ivNameIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_user"
                        app:tint="@color/v4_fg3" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="name"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat"
                        android:hint="@string/su_name_placeholder"
                        android:importantForAutofill="yes"
                        android:inputType="textPersonName|textCapWords"
                        android:letterSpacing="-0.005"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textColorHint="@color/v4_fg3"
                        android:textFontWeight="500"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />
                </LinearLayout>

                <!-- Email label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/su_email_label"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <!-- Email field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_v4_field_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/ivEmailIconSu"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_email"
                        app:tint="@color/v4_fg3" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="emailAddress"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat"
                        android:hint="@string/su_email_placeholder"
                        android:importantForAutofill="yes"
                        android:inputType="textEmailAddress"
                        android:letterSpacing="-0.005"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textColorHint="@color/v4_fg3"
                        android:textFontWeight="500"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />
                </LinearLayout>

                <!-- Email hint / error -->
                <TextView
                    android:id="@+id/tvEmailHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/su_email_hint"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="500"
                    android:textSize="11sp" />

                <!-- Continue CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContinue"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="-0.005"
                    android:text="@string/su_continue"
                    android:textFontWeight="600"
                    app:icon="@drawable/ic_glyph_arrow_right"
                    app:iconGravity="end"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg" />

                <!-- OR divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/v4_hairline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.12"
                        android:text="@string/su_or"
                        android:textAllCaps="true"
                        android:textColor="@color/v4_fg3"
                        android:textFontWeight="600"
                        android:textSize="10.5sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/v4_hairline" />
                </LinearLayout>

                <!-- Google sign up -->
                <LinearLayout
                    android:id="@+id/btnGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_v4_google_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_google" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="-0.005"
                        android:text="@string/su_google"
                        android:textColor="@color/v4_fg0"
                        android:textFontWeight="600"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Footer: Already have one? Sign in -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/su_already_account"
                        android:textColor="@color/v4_fg2"
                        android:textFontWeight="500"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvSignIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserrat"
                        android:text="@string/su_sign_in"
                        android:textColor="@color/v4_accent"
                        android:textFontWeight="600"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ STEP 2 ============ -->
            <LinearLayout
                android:id="@+id/stepTwoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="28dp"
                android:visibility="gone">

                <!-- Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/su_password_label"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <!-- Password field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_v4_field_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivPasswordIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_lock"
                        app:tint="@color/v4_fg3" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="newPassword"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat"
                        android:hint="@string/su_password_placeholder"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:letterSpacing="-0.005"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textColorHint="@color/v4_fg3"
                        android:textFontWeight="500"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />

                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_toggle_password"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_glyph_eye"
                        app:tint="@color/v4_fg3" />
                </LinearLayout>

                <!-- Strength meter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/strengthSeg1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_v4_strength_segment" />

                    <View
                        android:id="@+id/strengthSeg2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_v4_strength_segment" />

                    <View
                        android:id="@+id/strengthSeg3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_v4_strength_segment" />

                    <View
                        android:id="@+id/strengthSeg4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_v4_strength_segment" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStrengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/su_strength_default"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <!-- Confirm label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/montserrat"
                    android:letterSpacing="0.12"
                    android:text="@string/su_confirm_label"
                    android:textAllCaps="true"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="600"
                    android:textSize="10.5sp" />

                <!-- Confirm field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="7dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_v4_field_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/ivConfirmIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_lock"
                        app:tint="@color/v4_fg3" />

                    <EditText
                        android:id="@+id/etPasswordConfirm"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="newPassword"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat"
                        android:hint="@string/su_confirm_placeholder"
                        android:importantForAutofill="yes"
                        android:inputType="textPassword"
                        android:letterSpacing="-0.005"
                        android:maxLines="1"
                        android:textColor="@color/v4_fg0"
                        android:textColorHint="@color/v4_fg3"
                        android:textFontWeight="500"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />

                    <ImageView
                        android:id="@+id/ivConfirmCheck"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_check"
                        android:visibility="gone"
                        app:tint="@color/v4_ok" />
                </LinearLayout>

                <!-- Confirm hint / error -->
                <TextView
                    android:id="@+id/tvConfirmHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/v4_fg3"
                    android:textFontWeight="500"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Looks good." />

                <!-- Agreement row -->
                <LinearLayout
                    android:id="@+id/agreementWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:id="@+id/cbAgree"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_v4_remember_selector"
                        android:duplicateParentState="true">

                        <ImageView
                            android:id="@+id/ivAgreeCheck"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_glyph_check"
                            android:visibility="gone"
                            app:tint="@color/v4_bg" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/su_agreement"
                        android:textColor="@color/v4_fg2"
                        android:textFontWeight="500"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Create account CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreate"
                    style="@style/V4.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:enabled="false"
                    android:fontFamily="@font/montserrat"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="-0.005"
                    android:text="@string/su_create_account"
                    android:textFontWeight="600"
                    app:icon="@drawable/ic_glyph_check"
                    app:iconGravity="end"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/v4_bg" />

                <!-- Privacy note card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_v4_surface"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingHorizontal="13dp"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_glyph_shield"
                        app:tint="@color/v4_accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/su_privacy_note"
                        android:textColor="@color/v4_fg2"
                        android:textFontWeight="500"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/v4_accent"
        android:visibility="gone" />
</FrameLayout>
