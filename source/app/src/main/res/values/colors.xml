<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ─────────────────────────────────────────────────────────────
         S'CAN V4 - Light palette
         Cool neutrals · cyan accent · low-noise severity
         Token names: bg, surf1-3, hairlines, fg0-4, accent, severity
         Backwards-compat aliases at the bottom keep old layouts working.
         ───────────────────────────────────────────────────────────── -->

    <!-- Surfaces -->
    <color name="v4_bg">#F5F6F8</color>
    <color name="v4_surf1">#FFFFFF</color>
    <color name="v4_surf2">#FFFFFF</color>
    <color name="v4_surf3">#FAFBFC</color>
    <color name="v4_surf_tint">#05000000</color>
    <color name="v4_hairline">#140F1116</color>
    <color name="v4_hairline2">#240F1116</color>

    <!-- Foregrounds -->
    <color name="v4_fg0">#0B0D12</color>
    <color name="v4_fg1">#2B2F36</color>
    <color name="v4_fg2">#5C616B</color>
    <color name="v4_fg3">#8E939E</color>
    <color name="v4_fg4">#C9CCD3</color>

    <!-- Accent (LIME, light-mode = deep variant for AA contrast) -->
    <color name="v4_accent">#15803D</color>
    <color name="v4_accent_soft">#86EFAC</color>
    <color name="v4_accent_deep">#15803D</color>
    <color name="v4_accent_bg">#1E22C55E</color>
    <color name="v4_accent_ring">#4022C55E</color>

    <!-- Severity -->
    <color name="v4_ok">#059669</color>
    <color name="v4_ok_bg">#1A059669</color>
    <color name="v4_warn">#B45309</color>
    <color name="v4_warn_bg">#1AB45309</color>
    <color name="v4_bad">#DC2626</color>
    <color name="v4_bad_bg">#1ADC2626</color>

    <!-- Glass / overlay -->
    <color name="v4_glass_bg">#C7FFFFFF</color>
    <color name="v4_glass_border">#140F1116</color>

    <!-- Reverse-compat - every old name resolves to a V4 token -->
    <color name="primary">@color/v4_accent</color>
