<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security policy for S'CAN.

    Cleartext denied for all hosts; only system trust anchors. The AI sidecar lives
    behind Cloudflare's edge (real Let's Encrypt cert), so no app-bundled anchor is
    needed. Pin enforcement happens in OkHttp via ScanAiClient.PIN_LE_E7_INTERMEDIATE
    + PIN_ISRG_ROOT_X1.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
