<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating nav "glass pill" - opaque ink-1 with hairline and strong
  outer shadow (provided by elevation on the container). 999dp radius.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/scan_glass_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/ink_3" />
</shape>
