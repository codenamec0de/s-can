<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base surface with amber-tinted hairline border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_surf2" />
            <stroke android:width="1dp" android:color="@color/v4_warn_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Subtle amber wash to mirror the design's radial gradient -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_warn_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
