<?xml version="1.0" encoding="utf-8"?>
<!--
  Base hero card: vertical gradient ink-1 → ink-0 with hairline border.
  A second drawable (bg_scan_hero_glow) is layered on top in XML for the
  radial blue wash at the top centre.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/ink_1"
        android:endColor="@color/ink_0" />
    <stroke
        android:width="1dp"
        android:color="@color/ink_3" />
</shape>
