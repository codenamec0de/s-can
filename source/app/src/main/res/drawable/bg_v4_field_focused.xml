<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_accent_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_surf2" />
            <stroke
                android:width="1dp"
                android:color="@color/v4_accent_ring" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
