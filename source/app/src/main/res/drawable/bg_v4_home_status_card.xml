<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_surf2" />
            <stroke android:width="1dp" android:color="@color/v4_hairline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="1.0"
                android:centerY="0.0"
                android:startColor="@color/v4_accent_bg"
                android:endColor="@color/transparent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
