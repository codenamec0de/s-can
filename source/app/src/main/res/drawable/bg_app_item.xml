<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_surf3" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/v4_hairline2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v4_surf2" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/v4_hairline" />
        </shape>
    </item>
</selector>
